<Window
    x:Class="IcoConverter.CanvasColorPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:IcoConverter.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:IcoConverter.Utils"
    Title="选择自定义颜色"
    Width="460"
    Height="596"
    MinWidth="420"
    MinHeight="556"
    utils:DialogWindowBehavior.DialogResult="{Binding DialogResult}"
    ResizeMode="CanMinimize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="SwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="SwatchContainer"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchContainer" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <Setter TargetName="SwatchContainer" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SwatchContainer" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="SwatchContainer" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock FontSize="16" Text="选择自定义颜色" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Margin="0,0,0,12"
                Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="68"
                        Height="68"
                        VerticalAlignment="Center"
                        Background="{Binding PreviewBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                        BorderThickness="1"
                        CornerRadius="10" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock Opacity="0.72" Text="当前颜色" />
                        <TextBlock FontSize="18" Text="{Binding SelectedColorHex}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" Text="快速预设" />
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Hex}"
                                    Style="{StaticResource SwatchButtonStyle}"
                                    ToolTip="{Binding Name}">
                                    <Border
                                        Width="20"
                                        Height="20"
                                        Background="{Binding Brush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,8,0,4" Text="通道调整" />

                    <TextBlock Text="透明度 A" />
                    <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            VerticalAlignment="Center"
                            Maximum="255"
                            Minimum="0"
                            TickFrequency="1"
                            Value="{Binding Alpha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <controls:IntegerInput
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Maximum="255"
                            Minimum="0"
                            SmallChange="1"
                            Value="{Binding Alpha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock Text="红色 R" />
                    <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            VerticalAlignment="Center"
                            Maximum="255"
                            Minimum="0"
                            TickFrequency="1"
                            Value="{Binding Red, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <controls:IntegerInput
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Maximum="255"
                            Minimum="0"
                            SmallChange="1"
                            Value="{Binding Red, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock Text="绿色 G" />
                    <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            VerticalAlignment="Center"
                            Maximum="255"
                            Minimum="0"
                            TickFrequency="1"
                            Value="{Binding Green, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <controls:IntegerInput
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Maximum="255"
                            Minimum="0"
                            SmallChange="1"
                            Value="{Binding Green, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock Text="蓝色 B" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            VerticalAlignment="Center"
                            Maximum="255"
                            Minimum="0"
                            TickFrequency="1"
                            Value="{Binding Blue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <controls:IntegerInput
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Maximum="255"
                            Minimum="0"
                            SmallChange="1"
                            Value="{Binding Blue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                Grid.Row="3"
                Margin="0,14,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="96"
                    Height="34"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Content="取消" />
                <Button
                    Width="96"
                    Height="34"
                    Command="{Binding ConfirmCommand}"
                    Content="确定"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
