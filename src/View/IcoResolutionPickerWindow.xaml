<Window
    x:Class="IcoConverter.IcoResolutionPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:IcoConverter.Models"
    xmlns:utils="clr-namespace:IcoConverter.Utils"
    Title="{Binding WindowTitle}"
    Width="800"
    Height="600"
    MinWidth="580"
    MinHeight="628"
    utils:DialogWindowBehavior.DialogResult="{Binding DialogResult}"
    ResizeMode="CanMinimize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <utils:IcoPngFrameModeConverter x:Key="IcoPngFrameModeConverter" />

        <!--  预览背景铺棋盘格：透明区域在白底卡片上无法辨识  -->
        <DrawingBrush
            x:Key="PreviewCheckerBrush"
            Stretch="None"
            TileMode="Tile"
            Viewbox="0 0 10 10"
            ViewboxUnits="Absolute"
            Viewport="0,0,10,10"
            ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="M0,0 H10 V10 H0 Z" />
                    <GeometryDrawing Brush="#FFE6E6E6" Geometry="M0,0 H5 V5 H0 Z M5,5 H10 V10 H5 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="264" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,12">
                <TextBlock FontSize="16" Text="选择导出尺寸" />
                <TextBlock
                    Margin="0,6,0,0"
                    Opacity="0.75"
                    Text="{Binding IntroductionText}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,4,0,0"
                    Opacity="0.72"
                    Text="{Binding SourceImageSizeText}" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Grid.Column="0"
                Padding="10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ListBox
                    ItemsSource="{Binding ResolutionItems}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding SelectedResolution, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:IcoResolution}">
                            <Grid Margin="2,3,10,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="30"
                                    Height="30"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource PreviewCheckerBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <Image
                                        Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        MaxWidth="26"
                                        MaxHeight="26"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="{Binding Preview}"
                                        Stretch="Uniform" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    <TextBlock
                                        Margin="24,2,0,0"
                                        FontSize="11"
                                        Opacity="0.6"
                                        Text="{Binding Hint}"
                                        TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasHint}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 使用最近邻放大缩略图，便于检查像素边缘。 -->
            <Border
                Grid.Row="1"
                Grid.RowSpan="2"
                Grid.Column="1"
                Margin="12,0,0,0"
                Padding="14"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="12"
                        Opacity="0.6"
                        Text="预览" />

                    <Border
                        Grid.Row="1"
                        Margin="0,10"
                        Background="{StaticResource PreviewCheckerBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Image
                            Margin="10"
                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                            Source="{Binding SelectedPreviewImage}"
                            Stretch="Uniform" />
                    </Border>

                    <TextBlock
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Opacity="0.72"
                        Text="{Binding SelectedPreviewLabel}" />
                </Grid>
            </Border>

            <StackPanel
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,0,0,0">
                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsFrameModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        Opacity="0.75"
                        Text="ICO 帧编码" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding IcoPngFrameModeOptions}"
                        SelectedItem="{Binding FrameMode, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource IcoPngFrameModeConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Opacity="0.6"
                        Text="如果旧版软件无法读取此 ICO，请尝试选择「全部 BMP」。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border
                    Margin="0,10,0,0"
                    Padding="12,8"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    CornerRadius="6"
                    Visibility="{Binding IsHintOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding HintTitle}" />
                        <TextBlock Text="{Binding HintMessage}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid
                Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button
                        Width="74"
                        Height="32"
                        Command="{Binding SelectAllCommand}"
                        Content="全选" />
                    <Button
                        Width="74"
                        Height="32"
                        Margin="8,0,0,0"
                        Command="{Binding ClearAllCommand}"
                        Content="清空" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="90"
                        Height="32"
                        Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"
                        Content="取消" />
                    <Button
                        Width="90"
                        Height="32"
                        Command="{Binding ConfirmCommand}"
                        Content="导出"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
