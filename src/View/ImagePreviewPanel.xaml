<UserControl
    x:Class="IcoConverter.View.ImagePreviewPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:IcoConverter.Controls">
    <Border
        Padding="12"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Path
                        Width="13"
                        Height="13"
                        Data="{StaticResource IconEye}"
                        Style="{StaticResource FluentIcon}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        Style="{StaticResource SectionTitleStyle}"
                        Text="预览" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="10,4"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                    <StackPanel>
                        <TextBlock
                            MaxWidth="430"
                            Opacity="0.72"
                            Text="{Binding ImagePath, StringFormat=当前文件: {0}}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,2,0,0"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Opacity="0.99"
                            Text="{Binding PreviewModeHint}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Border Background="{Binding PreviewBackgroundBrush}" CornerRadius="12" />

                <Border
                    Margin="{Binding PreviewContentMargin}"
                    ClipToBounds="True"
                    CornerRadius="10"
                    Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="{Binding PreviewPixelWidth}" Height="{Binding PreviewPixelHeight}">
                            <Image
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="{Binding PreviewImage}"
                                Stretch="Fill" />

                            <Grid IsHitTestVisible="False" Visibility="{Binding IsMaskGuideVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Rectangle
                                    RadiusX="{Binding PreviewGuideCornerRadius}"
                                    RadiusY="{Binding PreviewGuideCornerRadius}"
                                    Stroke="#B3000000"
                                    StrokeDashArray="6 4"
                                    StrokeThickness="3"
                                    Visibility="{Binding IsRoundedMaskSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <Rectangle
                                    RadiusX="{Binding PreviewGuideCornerRadius}"
                                    RadiusY="{Binding PreviewGuideCornerRadius}"
                                    Stroke="#FFF6B65A"
                                    StrokeDashArray="6 4"
                                    StrokeThickness="1.5"
                                    Visibility="{Binding IsRoundedMaskSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <Grid ClipToBounds="True" Visibility="{Binding IsCircleMaskSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <!--  外切引导线保留实际半径，超出部分由预览容器裁剪。  -->
                                    <Ellipse
                                        Width="{Binding CircleGuideDiameter}"
                                        Height="{Binding CircleGuideDiameter}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stroke="#B3000000"
                                        StrokeDashArray="6 4"
                                        StrokeThickness="3" />
                                    <Ellipse
                                        Width="{Binding CircleGuideDiameter}"
                                        Height="{Binding CircleGuideDiameter}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stroke="#FF7ECDF2"
                                        StrokeDashArray="6 4"
                                        StrokeThickness="1.5" />

                                    <Ellipse
                                        Width="{Binding CircleReferenceDiameter}"
                                        Height="{Binding CircleReferenceDiameter}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stroke="#8C000000"
                                        StrokeDashArray="3 3"
                                        StrokeThickness="2"
                                        Visibility="{Binding IsCircleReferenceVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Ellipse
                                        Width="{Binding CircleReferenceDiameter}"
                                        Height="{Binding CircleReferenceDiameter}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stroke="#FF7FD19A"
                                        StrokeDashArray="3 3"
                                        StrokeThickness="1.2"
                                        Visibility="{Binding IsCircleReferenceVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Line
                                        Opacity="0.6"
                                        Stroke="#B3000000"
                                        StrokeThickness="1.6"
                                        X1="0"
                                        X2="{Binding PreviewPixelWidth}"
                                        Y1="{Binding PreviewPixelHeight}"
                                        Y2="0" />
                                    <Line
                                        Opacity="0.78"
                                        Stroke="#CCFFFFFF"
                                        StrokeThickness="1"
                                        X1="0"
                                        X2="{Binding PreviewPixelWidth}"
                                        Y1="0"
                                        Y2="{Binding PreviewPixelHeight}" />

                                    <Line
                                        Opacity="0.6"
                                        Stroke="#B3000000"
                                        StrokeThickness="1.6"
                                        X1="0"
                                        X2="{Binding PreviewPixelWidth}"
                                        Y1="0"
                                        Y2="{Binding PreviewPixelHeight}" />
                                    <Line
                                        Opacity="0.78"
                                        Stroke="#CCFFFFFF"
                                        StrokeThickness="1"
                                        X1="0"
                                        X2="{Binding PreviewPixelWidth}"
                                        Y1="{Binding PreviewPixelHeight}"
                                        Y2="0" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Viewbox>
                </Border>

                <controls:CropOverlay
                    Margin="{Binding PreviewContentMargin}"
                    HandleSize="11"
                    ImageHeight="{Binding PreviewPixelHeight}"
                    ImageWidth="{Binding PreviewPixelWidth}"
                    Selection="{Binding CropSelection, Mode=TwoWay}"
                    Visibility="{Binding IsCropOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border
                    Margin="0,14,0,0"
                    Padding="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="#E6141517"
                    BorderBrush="#2EFFFFFF"
                    BorderThickness="1"
                    CornerRadius="21"
                    Visibility="{Binding IsCropOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="18"
                            Opacity="0.38"
                            ShadowDepth="3"
                            Color="#FF000000" />
                    </Border.Effect>

                    <StackPanel Orientation="Horizontal">
                        <Button
                            Command="{Binding CancelCropCommand}"
                            Style="{StaticResource CropOverlayButtonStyle}"
                            ToolTip="放弃本次调整（Esc）">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Width="12"
                                    Height="12"
                                    Data="{StaticResource IconDismiss}"
                                    Style="{StaticResource FluentIcon}" />
                                <TextBlock Margin="6,0,0,0" Text="取消" />
                            </StackPanel>
                        </Button>

                        <Button
                            Margin="4,0,0,0"
                            Command="{Binding ApplyCropCommand}"
                            Style="{StaticResource CropOverlayPrimaryButtonStyle}"
                            ToolTip="应用裁剪（Enter）">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Width="12"
                                    Height="12"
                                    Data="{StaticResource IconCheckmark}"
                                    Style="{StaticResource FluentIcon}" />
                                <TextBlock Margin="6,0,0,0" Text="应用" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="12"
                    IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="{Binding PreviewImage, Converter={StaticResource NullToVisibilityConverter}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDropHintVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path
                            Width="47"
                            Height="47"
                            HorizontalAlignment="Center"
                            Data="{StaticResource IconExportPng}"
                            Opacity="0.78"
                            Style="{StaticResource FluentIcon}" />
                        <TextBlock
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            Text="拖放图片到这里" />
                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            Opacity="0.7"
                            Text="或点击顶部工具栏「打开」" />
                    </StackPanel>
                </Border>

                <Border
                    CornerRadius="12"
                    IsHitTestVisible="False"
                    Visibility="{Binding IsDropHintVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <!--  拖放遮罩使用当前主题的背景色。  -->
                        <Rectangle
                            Fill="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            Opacity="0.82"
                            RadiusX="12"
                            RadiusY="12" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Center"
                                Data="{StaticResource IconOpen}"
                                Fill="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                FontSize="20"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="释放鼠标以载入文件" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border
                Grid.Row="2"
                Margin="0,12,0,0"
                Padding="10,8"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                CornerRadius="10">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Path
                        Margin="0,0,8,0"
                        Data="{Binding NotificationSeverity, Converter={StaticResource NotificationLevelToIconConverter}}"
                        Style="{StaticResource FluentIcon}" />
                    <TextBlock
                        Opacity="0.88"
                        Text="{Binding NotificationMessage}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

    </Border>
</UserControl>
