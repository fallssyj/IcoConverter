<Window
    x:Class="IcoConverter.IcoToPngWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:IcoConverter.Models"
    Title="{Binding HeaderText}"
    Width="760"
    Height="576"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <!--  预览背景铺棋盘格：透明区域在白底卡片上无法辨识  -->
        <DrawingBrush
            x:Key="PreviewCheckerBrush"
            Stretch="None"
            TileMode="Tile"
            Viewbox="0 0 10 10"
            ViewboxUnits="Absolute"
            Viewport="0,0,10,10"
            ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="M0,0 H10 V10 H0 Z" />
                    <GeometryDrawing Brush="#FFE6E6E6" Geometry="M0,0 H5 V5 H0 Z M5,5 H10 V10 H5 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="232" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,12">
                <TextBlock FontSize="16" Text="{Binding HeaderText}" />
                <TextBlock Margin="0,6,0,0" Text="请选择要导出的尺寸和输出目录。" />
            </StackPanel>

            <Grid
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{Binding PathLabel}" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="8,0"
                    IsReadOnly="True"
                    Text="{Binding IconPath, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="输出目录" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="8,5"
                    Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    Width="80"
                    Height="30"
                    Margin="6,0,0,0"
                    Command="{Binding BrowseOutputCommand}"
                    Content="浏览" />
            </Grid>

            <Border
                Grid.Row="2"
                Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        Opacity="0.5"
                        Text="{Binding ResolutionsLabel}" />

                    <Border
                        Grid.Row="1"
                        Padding="10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <ListBox
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding Resolutions}"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectedItem="{Binding SelectedResolution, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:IcoResolution">
                                    <Grid Margin="1,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="30"
                                            Height="30"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource PreviewCheckerBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <Image
                                                Width="{Binding Width}"
                                                Height="{Binding Height}"
                                                MaxWidth="26"
                                                MaxHeight="26"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                Source="{Binding Preview}"
                                                Stretch="Uniform" />
                                        </Border>

                                        <CheckBox
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Content="{Binding DisplayText}"
                                            IsChecked="{Binding IsSelected}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <WrapPanel
                        Grid.Row="2"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center">
                        <Button
                            Width="80"
                            Height="30"
                            Margin="0,0,10,0"
                            Command="{Binding SelectAllCommand}"
                            Content="全选" />
                        <Button
                            Width="80"
                            Height="30"
                            Command="{Binding ClearAllCommand}"
                            Content="清空" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- 使用最近邻放大已解码的帧，便于检查像素边缘。 -->
            <Border
                Grid.Row="2"
                Grid.Column="1"
                Margin="12,0,0,0"
                Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="12"
                        Opacity="0.6"
                        Text="预览" />

                    <Border
                        Grid.Row="1"
                        Margin="0,8"
                        Background="{StaticResource PreviewCheckerBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Image
                            Margin="8"
                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                            Source="{Binding SelectedPreviewImage}"
                            Stretch="Uniform" />
                    </Border>

                    <TextBlock
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Opacity="0.72"
                        Text="{Binding SelectedPreviewLabel}" />
                </Grid>
            </Border>

            <Grid
                Grid.Row="3"
                Grid.ColumnSpan="2"
                Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{Binding StatusMessage}" />
                <Button
                    Grid.Column="1"
                    Width="90"
                    Height="30"
                    Margin="0,0,10,0"
                    Command="{Binding ConvertCommand}"
                    Content="导出" />
                <Button
                    Grid.Column="2"
                    Width="90"
                    Height="30"
                    Command="{Binding CloseCommand}"
                    Content="取消" />
            </Grid>
        </Grid>
    </Grid>
</Window>
