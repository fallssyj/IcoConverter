<Window
    x:Class="IcoConverter.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Title}"
    Width="560"
    Height="576"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Margin="24,4,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image
                Width="48"
                Height="48"
                Source="/Assets/PNG/app.png" />

            <StackPanel
                Grid.Column="1"
                Margin="14,0,0,0"
                VerticalAlignment="Center">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="IcoConverter" />
                <TextBlock
                    Margin="0,3,0,0"
                    Opacity="0.62"
                    Text="{Binding Subtitle}" />
            </StackPanel>

            <Button
                Grid.Column="2"
                Height="36"
                Padding="16,0"
                VerticalAlignment="Center"
                Command="{Binding CheckUpdateCommand}"
                ToolTip="从 GitHub 获取最新版本">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconSync}" Style="{StaticResource FluentIcon}" />
                    <TextBlock Margin="8,0,0,0" Text="检查更新" />
                </StackPanel>
            </Button>
        </Grid>

        <TabControl
            Grid.Row="2"
            Margin="24,0,24,0">
            <TabItem Header="鸣谢">
                <ListBox
                    Margin="0,8,0,0"
                    Padding="4"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Libraries}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,5">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="12"
                                    Opacity="0.6"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem Header="MIT License">
                <TextBox
                    Margin="0,8,0,0"
                    Padding="12"
                    FontSize="12"
                    AcceptsReturn="True"
                    Background="Transparent"
                    BorderThickness="0"
                    IsReadOnly="True"
                    Text="{Binding LicenseText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="24,14,24,16">
            <TextBlock
                VerticalAlignment="Center"
                Opacity="0.62"
                Text="© 2026 IcoConverter · MIT License" />

            <Button
                Height="32"
                Padding="12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Command="{Binding OpenProjectPageCommand}"
                ToolTip="在浏览器中打开项目主页">
                <StackPanel Orientation="Horizontal">
                    <Path
                        Width="13"
                        Height="13"
                        Margin="0,0,7,0"
                        VerticalAlignment="Center"
                        Data="{StaticResource IconGitHub}"
                        Opacity="0.85"
                        Style="{StaticResource FluentIcon}" />
                    <TextBlock Opacity="0.85" Text="GitHub" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
